<?xml version="1.0" encoding="utf-8"?>
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">

    <!-- Device Utilities -->
    <Type Name="utils::device::HostInfo">
        <DisplayString Condition="0 == m_value._Which">{m_value._Head}</DisplayString>
        <DisplayString Condition="1 == m_value._Which">{m_value._Tail._Head,s8b}</DisplayString>
        <DisplayString Condition="2 == m_value._Which">Empty</DisplayString>
    </Type>
    <Type Name="utils::device::socketInfo">
        <DisplayString>
            {host}:{port}
        </DisplayString>
    </Type>
    <Type Name="utils::device::deviceInfo">
        <DisplayString Condition="utils::device::TYPE_TCP == type">
            TCP://{info._Head}
        </DisplayString>
        <DisplayString Condition="utils::device::TYPE_UDP == type">
            UDP://{info._Head}
        </DisplayString>
        <DisplayString Condition="utils::device::TYPE_SERIAL == type">
            {info._Tail._Head}
        </DisplayString>
        <DisplayString>Unsupported</DisplayString>
    </Type>

    <!-- Misc Utilities -->
    <Type Name="utils::resources::Icon">
        <DisplayString>{m_subPath,s8b}.svg</DisplayString>
    </Type>

    <Type Name="control::version">
        <DisplayString>{major}.{minor}.{micro}</DisplayString>
    </Type>

	<!-- Layout Components -->

	<Type Name="layout::ComponentDerived&lt;*&gt;">
		<DisplayString>{m_state->m_name,s8b}</DisplayString>
		<Expand>
			<Item Name="ID">m_id</Item>
			<Item Name="Controller" Condition="nullptr != m_controller">*m_controller</Item>
			<ExpandedItem Condition="nullptr != m_state._Ptr">*m_state._Ptr</ExpandedItem>
		</Expand>
	</Type>

	<Type Name="layout::funcInfo">
		<DisplayString>{{ ID = {(int)id}, icon = {icon,en} }} </DisplayString>
	</Type>

	<Type Name="layout::routeMember">
		<DisplayString Condition="state">{actuator} (ON)</DisplayString>
		<DisplayString Condition="!state">{actuator} (OFF)</DisplayString>
	</Type>

	<Type Name="layout::locomotiveState">
		<Expand>
			<Item Name="Name">m_name,s8b</Item>
			<Item Name="Track Protocol">m_proto,en</Item>
			<Item Name="Track Address">m_address</Item>
			<Item Name="Functions">m_functions</Item>
		</Expand>
	</Type>

	<Type Name="layout::routeState">
		<Expand>
			<Item Name="Name">m_name,s8b</Item>
			<Item Name="Members">m_members</Item>
		</Expand>
	</Type>

	<Type Name="layout::actuatorState">
		<Expand>
			<Item Name="Name">m_name,s8b</Item>
			<Item Name="Icon">m_icon,en</Item>
			<Item Name="State">m_state</Item>
			<Item Name="Mode">m_mode,en</Item>
			<Item Name="Address">m_address</Item>
			<Item Name="Duration">m_duration</Item>
		</Expand>
	</Type>

    <!-- Protocols -->
    <Type Name="control::ProtocolMetaClassBase">
        <DisplayString>{friendlyName,s8b}</DisplayString>
    </Type>

    <Type Name="control::ProtocolBase">
        <DisplayString>{m_deviceInfo}</DisplayString>
    </Type>

    <!-- Controllers -->
    <Type Name="control::ControllerMetaClassBase">
        <DisplayString>{friendlyName,s8b}</DisplayString>
    </Type>

    <Type Name="control::ControllerBase">
        <DisplayString>{m_friendlyName,s8b}</DisplayString>
        <Expand>
            <Item Name="[Name]">m_friendlyName,s8b</Item>
            <Item Name="[Thread]">m_thread</Item>
			<Item Name="[Actuators]">((layout::ControllerBase&lt;layout::Actuator&gt;&amp;)*this).m_components</Item>
			<Item Name="[Locomotives]">((layout::ControllerBase&lt;layout::Locomotive&gt;&amp;)*this).m_components</Item>
			<Item Name="[Routes]">((layout::ControllerBase&lt;layout::Route&gt;&amp;)*this).m_components</Item>
		</Expand>
    </Type>

    <Type Name="control::ControllerManager">
        <DisplayString>{m_controllers}</DisplayString>
        <Expand HideRawView="true">
            <Item Name="[size]">m_controllers.size()</Item>
            <Item Name="[capacity]">m_controllers.capacity()</Item>
            <CustomListItems>
                <Variable Name="ii" InitialValue="0"/>
                <Size>m_controllers.size()</Size>
                <Loop>
                    <Break Condition="m_controllers.size() == ii"/>
                    <Item>*m_controllers._Mypair._Myval2._Myfirst[ii]</Item>
                    <Exec>++ii</Exec>
                </Loop>
            </CustomListItems>
        </Expand>
    </Type>

    <!-- Connection Worker Thread-->
    <Type Name="control::ConnectionWorkerThread">
        <DisplayString>{*m_proto} ({m_health})</DisplayString>
        <Expand>
            <Item Name="[Protocol]">*m_proto</Item>
            <Item Name="[Tasks]">m_taskQueue</Item>
            <Item Name="[Pinger]">*m_pinger</Item>
            <Item Name="[Health]">m_health</Item>
        </Expand>
    </Type>

    <Type Name="control::ConnectionWorkerThread::health">
        <DisplayString
            Condition="HEALTH_DEAD == level || HEALTH_DISCONNECTED == level">
            Disconnected
        </DisplayString>
        <DisplayString Condition="HEALTH_CONNECTED == level">
            Connected
        </DisplayString>
        <DisplayString>Ping {ping._MyRep} ms</DisplayString>
    </Type>

    <Type Name="utils::IpV4Pinger">
        <DisplayString>
            ICMP://{0xFF &amp; m_ip}.{(0xFF00 &amp; m_ip) >> 8}.{(0xFF0000 &amp; m_ip) >> 16}.{(0xFF000000 &amp; m_ip) >> 24}
        </DisplayString>
    </Type>

    <Type Name="utils::Pinger">
        <DisplayString>{*m_impl}</DisplayString>
    </Type>

    <!-- Automations -->
    <Type Name="control::FastClock">
        <!-- TODO: Figure out the running case-->
        <!--
        <DisplayString Condition="m_running">
            {reinterpret_cast&lt;control::FastClock::time_point&gt;
                (m_startTime._MyDur._MyRep +
                 m_ratio * (std::chrono::system_clock::now()._MyDur._MyRep -
                            m_startTimeSystem._MyDur._MyRep))}
        </DisplayString>
        -->
        <DisplayString Condition="!m_running">{m_startTime} (stopped)</DisplayString>
        <Expand>
            <Item Name="[Start Time (Simulated)]">m_startTime</Item>
            <Item Name="[Start Time (Real)]">m_startTimeSystem</Item>
            <Synthetic Name="[Ratio]"><DisplayString>1:{m_ratio}</DisplayString></Synthetic>
            <Item Name="[State]" Condition="m_running">"Running",s8b</Item>
            <Item Name="[State]" Condition="!m_running">"Stopped",s8b</Item>
        </Expand>
    </Type>


	<Type Name="control::AutomationItem::function">
		<DisplayString>{loco} - {(int)func}</DisplayString>
		<Expand>
			<Item Name="Locomotive">loco</Item>
			<Item Name="Function Number">(int)func</Item>
		</Expand>
	</Type>

	<Type Name="control::AutomationItem">
		<DisplayString Condition="m_item.index() == 0" Optional="true">Actuator : {m_item._Head}</DisplayString>
		<DisplayString Condition="m_item.index() == 1" Optional="true">Route : {m_item._Tail._Head}</DisplayString>
		<DisplayString Condition="m_item.index() == 2" Optional="true">Locomotive Function : {m_item._Tail._Tail._Head}</DisplayString>
		<Expand>
			<ExpandedItem Condition="m_item.index() == 0" Optional="true">m_item._Head</ExpandedItem>
			<ExpandedItem Condition="m_item.index() == 1" Optional="true">m_item._Tail._Head</ExpandedItem>
			<ExpandedItem Condition="m_item.index() == 2" Optional="true">m_item._Tail._Tail._Head</ExpandedItem>
		</Expand>
	</Type>

	<Type Name="control::AutomationManager">
		<DisplayString>{m_tasks}</DisplayString>
		<Expand>
			<ExpandedItem>m_tasks</ExpandedItem>
		</Expand>
	</Type>

	<Type Name="control::AutomationAlarm">
		<DisplayString>At {m_time.hour()}:{m_time.minute()/10,d}{m_time.minute()%10,d}:{m_time.second()/10,d}{m_time.second()%10,d}</DisplayString>
	</Type>

	<Type Name="control::AutomationTimer">
		<DisplayString>Every {m_duration}</DisplayString>
	</Type>

	<Type Name="control::AutomationTask">
		<DisplayString>{name}</DisplayString>
		<Expand>
			<Item Name="Name">name</Item>
			<Synthetic Name="Task">
				<DisplayString Condition="ACTION_SET == action">{*condition} set {*m_item}</DisplayString>
				<DisplayString Condition="ACTION_UNSET == action">{*condition} unset {*m_item}</DisplayString>
				<DisplayString Condition="ACTION_TOGGLE == action">{*condition} toggle {*m_item}</DisplayString>
				<Expand>
					<Item Name="Action">action,en</Item>
					<Item Name="Condition">*condition</Item>
					<Item Name="Item">*m_item</Item>
				</Expand>
			</Synthetic>
			<Synthetic Name="Config">
				<DisplayString>{{ Enabled = {enabled}, Do Once = {doOnce} }}</DisplayString>
				<Expand>
					<Item Name="Enabled">enabled</Item>
					<Item Name="Do Once">doOnce</Item>
				</Expand>
			</Synthetic>
			<Synthetic Name="Times">
				<DisplayString>{{ Last Check = {m_lastChecked}, Last Run = {m_lastRun} }}</DisplayString>
				<Expand>
					<Item Name="Last Check">m_lastChecked</Item>
					<Item Name="Last Run">m_lastRun</Item>
				</Expand>
			</Synthetic>
		</Expand>
	</Type>

    <!-- Common UI Elements-->
    <Type Name="ui::common::SchemeTabWidget">
        <DisplayString>Icon Count = {m_icons.size()}</DisplayString>
        <Expand>
            <ExpandedItem>m_icons</ExpandedItem>
        </Expand>
    </Type>

    <Type Name="ui::common::AutoGridLayout">
        <DisplayString>{{ count = {m_items.size()} }}</DisplayString>
        <Expand>
            <Item Name="[Expand]">m_expand</Item>
            <ExpandedItem>m_items</ExpandedItem>
        </Expand>
    </Type>

    <Type Name="ui::common::HexValidator">
        <DisplayString>Min = {m_min}, Max = {m_max}</DisplayString>
        <Expand HideRawView="true">
            <Item Name="[Min]">m_min</Item>
            <Item Name="[Max]">m_max</Item>
        </Expand>
    </Type>

    <Type Name="ui::common::IpField">
        <DisplayString>{m_proto,en}</DisplayString>
        <Expand>
            <Item Name="[Proto]">m_proto</Item>
            <Synthetic Name="[Fields]">
                <DisplayString>{m_fields}</DisplayString>
                <Expand>
                    <ExpandedItem>m_fields</ExpandedItem>
                </Expand>
            </Synthetic>
        </Expand>
    </Type>

    <Type Name="ui::common::ToggleSwitch">
        <DisplayString Condition="m_switch">Toggled On</DisplayString>
        <DisplayString Condition="!m_switch">Toggled Off</DisplayString>
    </Type>
</AutoVisualizer>